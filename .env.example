# Скопируй в .env и заполни РЕАЛЬНЫМИ значениями:  cp .env.example .env
# .env в git НЕ попадает. Пароли сгенерируй:  openssl rand -base64 24

# Адрес сайта для Caddy.
#   Пока нет домена  → :80  (HTTP по IP сервера)
#   Когда есть домен → board.example.com  (Caddy сам получит HTTPS)
SITE_ADDRESS=:80

# Вход в приложение. Приоритет:
#   1) INVITE_CODE задан → личные аккаунты (регистрация по коду, у каждого свой вход).
#   2) иначе AUTH_PASSWORD задан → общий вход (один логин/пароль на всех).
#   3) иначе → доступ открыт.
AUTH_LOGIN=admin
AUTH_PASSWORD=

# Код-приглашение для регистрации личных аккаунтов. Пусто — аккаунты выключены.
INVITE_CODE=

# Домены корпоративной почты, с которых разрешена регистрация (через запятую).
# Не задано или пусто — действуют домены по умолчанию: ithona.tj, fazo-tech.tj.
# Снять ограничение (разрешить любую почту) можно только явно: ALLOWED_EMAIL_DOMAINS=*
ALLOWED_EMAIL_DOMAINS=ithona.tj,fazo-tech.tj

# Telegram-бот для напоминаний (дни рождения за 2 дня + дедлайны).
#   1) В Telegram напиши @BotFather → /newbot → получи токен.
#   2) Вставь токен сюда. Пусто — уведомления выключены.
#   3) В приложении: Компания → «Подключить Telegram».
TELEGRAM_BOT_TOKEN=
# Час рассылки напоминаний (по UTC, 0–23). 6 UTC ≈ 11:00 в Ташкенте (UTC+5).
TELEGRAM_REMINDER_HOUR=6

# PostgreSQL
POSTGRES_USER=ithona
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ithona

# MinIO — хранилище вложений (S3-совместимое)
MINIO_ROOT_USER=ithona
MINIO_ROOT_PASSWORD=change_me_strong_password
