# HONA Core 2.0 — пример окружения для ЛОКАЛЬНОЙ разработки (Phase 1).
#
#   cp .env.example .env      затем замените каждое change-me своим значением
#
# .env не коммитится и никогда не source-ится shell-скриптами: его читают
# docker compose (docker-compose.dev.yml) и Node (--env-file). Здесь только имена
# переменных и примеры формата; реальных секретов, IP и имён серверов здесь нет.
# Полное описание переменных — docs/development.md.

# ── Процессы на хосте: api, worker, web ─────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Адрес, по которому браузер открывает web (Vite dev server). Мутации с чужим Origin → 403.
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL из docker-compose.dev.yml (127.0.0.1:5433). Пароли совпадают с HONA_*_PASSWORD ниже.
DATABASE_URL=postgres://hona_app:change-me-app@127.0.0.1:5433/hona
DATABASE_URL_MIGRATE=postgres://hona_migrate:change-me-migrate@127.0.0.1:5433/hona

REDIS_URL=redis://127.0.0.1:6380

# MinIO (S3 API). S3_ACCESS_KEY/S3_SECRET_KEY — пользователь приложения, его создаёт minio-init.
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hona
S3_ACCESS_KEY=hona-app
S3_SECRET_KEY=change-me-s3-secret

WORKER_ID=worker-local
WORKER_HEALTH_PORT=3001

# ── Только docker-compose.dev.yml ───────────────────────────────────────────
POSTGRES_PASSWORD=change-me-postgres
HONA_MIGRATE_PASSWORD=change-me-migrate
HONA_APP_PASSWORD=change-me-app
HONA_READONLY_PASSWORD=change-me-readonly
MINIO_ROOT_USER=hona-minio-admin
MINIO_ROOT_PASSWORD=change-me-minio-root
# Переопределение образов MinIO, если реестр по умолчанию недоступен (docs/development.md):
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
# MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z

# ── Только интеграционные тесты (создают и удаляют базы hona_test_*) ────────
TEST_DATABASE_ADMIN_URL=postgres://postgres:change-me-postgres@127.0.0.1:5433/postgres
