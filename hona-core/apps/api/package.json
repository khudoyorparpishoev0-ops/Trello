{
  "name": "@hona/api",
  "version": "0.1.0",
  "private": true,
  "description": "HONA Core 2.0 API — Fastify 5. Phase 1: health, readiness, events/outbox foundation.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "openapi:generate": "tsx --conditions=source scripts/openapi.ts --write",
    "openapi:check": "tsx --conditions=source scripts/openapi.ts --check",
    "system:ping": "tsx --conditions=source --env-file-if-exists=../../.env scripts/system-ping.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/swagger": "9.9.0",
    "@hona/db": "0.1.0",
    "@hona/shared": "0.1.0",
    "close-with-grace": "2.5.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.11.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "uuidv7": "1.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "openapi-types": "12.1.3",
    "pino-pretty": "13.1.3"
  }
}
